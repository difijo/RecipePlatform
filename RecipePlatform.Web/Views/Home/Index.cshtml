@model IEnumerable<RecipePlatform.Core.Entities.Recipe>

@{
    ViewData["Title"] = "Home";
    Layout = "_Layout"; 
}

<h1 class="mb-4 text-center">Popular recepi</h1>

<!--carousel -->
<div id="recipeCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
    <div class="carousel-inner">
        @for (int i = 0; i < Model.Count(); i++)
        {
            var recipe = Model.ElementAt(i);
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="d-flex justify-content-center">
                    <div class="card shadow" style="width: 50%;">
                        <div class="card-body text-center">
                            <h5 class="card-title">
                                <a asp-action="Details" asp-route-id="@recipe.Id" class="text-decoration-none">
                                    @recipe.Title
                                </a>
                            </h5>
                            <h6 class="card-subtitle mb-2 text-muted">@recipe.Category?.Name</h6>
                            <p class="card-text">@recipe.Description</p>
                            <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary mt-2">More</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#recipeCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#recipeCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<hr />

<h2 class="mt-4 mb-3 text-center">All recepi</h2>

<div class="row">
    @foreach (var recipe in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@recipe.Id" class="text-decoration-none">
                            @recipe.Title
                        </a>
                    </h5>
                    <h6 class="card-subtitle mb-2 text-muted">@recipe.Category?.Name</h6>
                    <p class="card-text">@recipe.Description</p>
                    <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary btn-sm mt-2">More</a>
                </div>
            </div>
        </div>
    }
</div>
